// ============================================================================
//  PORTFOLIO CMS — Prisma Schema (Prisma 7 Compatible)
//  PostgreSQL · Next.js App Router
//
//  Design: Single-owner portfolio.
//  One canonical User (owner). Multiple login identities via Auth.js Account model.
//  TrackedSession provides JWT revocation without abandoning JWT strategy.
//  AuditLog records every meaningful mutation with before/after snapshots.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Note: 'url' property is configured in prisma.config.ts for Prisma 7 compatibility
}

// ============================================================================
//  ENUMS
// ============================================================================

enum PublishState {
  DRAFT
  PUBLISHED
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  PLANNED
}

enum ProjectCategory {
  WEB
  FULL_STACK
  MACHINE_LEARNING
  JAVA
  ACADEMIC
  OTHER
}

enum TechCategory {
  FRONTEND
  BACKEND
  DATABASE
  AI_ML
  MOBILE
  TOOLS
  DEVOPS
  OTHER
}

enum ExperienceLabel {
  STRONG
  COMFORTABLE
  WORKING_KNOWLEDGE
  LEARNING
}

enum WorkType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  FREELANCE
  VOLUNTEER
}

enum TimelineEntryType {
  PROJECT
  ACADEMIC
  MILESTONE
  PERSONAL
}

enum SectionType {
  HERO
  ABOUT
  TECH_STACK
  FEATURED_PROJECTS
  PROJECT_GRID
  PROJECT_TIMELINE
  EDUCATION
  EXPERIENCE
  CUSTOM_CONTENT
  STACK_GAME
  CONTACT
  CALL_TO_ACTION
  FOOTER_SPACER
}

enum TemplateKey {
  PROFESSIONAL_MINIMAL
  MODERN_GLASS
  INTERACTIVE_3D
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum MessageCategory {
  GENERAL
  OPPORTUNITY
  COLLABORATION
  OTHER
}

enum MediaKind {
  IMAGE
  DOCUMENT // e.g. CV pdf
  LOGO
}

enum GameMode {
  ROTATING_SPHERE
  FLOATING_BALLS
  FALLING_GAME
  STATIC_FALLBACK
}

// ============================================================================
//  USER  (the single canonical portfolio owner)
// ============================================================================

model User {
  id                   String    @id @default(cuid())
  username             String    @unique
  email                String    @unique
  name                 String?
  /// PBKDF2-SHA256 hash: "iterations:salt:hash" — null when no local password set
  passwordHash         String?   @map("password_hash")
  mustChangePassword   Boolean   @default(false) @map("must_change_password")
  avatarUrl            String?   @map("avatar_url")
  lastLoginAt          DateTime? @map("last_login_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  accounts          Account[]
  trackedSessions   TrackedSession[]
  auditLogs         AuditLog[]
  publishedVersions PageVersion[]    @relation("VersionPublisher")
  uploadedMedia     MediaAsset[]     @relation("MediaUploader")

  @@map("users")
}

// ============================================================================
//  AUTH.JS — ACCOUNT  (one row per linked login identity)
//  provider = "credentials" → local username/password
//  provider = "google"      → a linked Google account
// ============================================================================

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // "credentials" | "google"
  providerAccountId String   @map("provider_account_id")  // Google OIDC subject (stable)
  type              String   // "credentials" | "oauth"
  /// Verified email of this identity — for display only; not used as login key
  email             String?
  access_token      String?  @db.Text
  refresh_token     String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text

  trackedSessions TrackedSession[]

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ============================================================================
//  TRACKED SESSION  (database-side revocation record for JWT sessions)
//  The `sid` field is embedded in the encrypted Auth.js JWT cookie.
//  requireAdmin() reads sid from the JWT and validates it here.
// ============================================================================

model TrackedSession {
  id           String    @id @default(cuid())
  /// Random UUID injected into the JWT to identify this specific session
  sid          String    @unique
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "LOCAL" | "GOOGLE"
  loginMethod  String    @map("login_method")
  /// Nullable: set to Account.id when loginMethod = GOOGLE
  accountId    String?   @map("account_id")
  account      Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("tracked_sessions")
}

// ============================================================================
//  ACCOUNT LINK INTENT  (short-lived token for linking a Google account)
//  Created when authenticated owner clicks "Link Another Google Account".
//  Validated in the OAuth callback before linking the Account row.
// ============================================================================

model AccountLinkIntent {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  /// SHA-256 hash of the one-time link token (never store the raw token)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("account_link_intents")
}

// ============================================================================
//  LOGIN ATTEMPT  (rate-limiting; ephemeral — no PII stored)
// ============================================================================

model LoginAttempt {
  id        String   @id @default(cuid())
  emailHash String   @map("email_hash")
  ipHash    String   @map("ip_hash")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

// ============================================================================
//  MEDIA ASSET  (reusable images / docs / logos referenced everywhere)
// ============================================================================

model MediaAsset {
  id         String    @id @default(cuid())
  url        String // storage URL (Supabase / Cloudinary)
  kind       MediaKind @default(IMAGE)
  filename   String
  altText    String?
  mimeType   String?
  sizeBytes  Int?
  width      Int?
  height     Int?
  deletedAt  DateTime? // soft delete
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  uploadedById String?
  uploadedBy   User?   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  // reverse references so we can compute "used in" and block deletion
  projectThumbnails    ProjectVersion[] @relation("ProjectThumbnail")
  projectCovers        ProjectVersion[] @relation("ProjectCover")
  projectArchitectures ProjectVersion[] @relation("ProjectArchitecture")
  galleryItems         ProjectImage[]
  technologies         TechnologyVersion[]
  timelineImages       TimelineEntryVersion[]
  educationLogos       EducationVersion[]
  experienceLogos      ExperienceVersion[]
  socialIcons          SocialLink[]

  // single-record profile media
  profileImage SiteProfile[] @relation("ProfileImage")
  logoImage    SiteProfile[] @relation("LogoImage")
  faviconImage SiteProfile[] @relation("FaviconImage")
  cvFile       SiteProfile[] @relation("CvFile")

  @@index([kind])
  @@index([deletedAt])
  @@map("media_assets")
}

// ============================================================================
//  SITE PROFILE  (single row: identity + global settings)
// ============================================================================

model SiteProfile {
  id                  String  @id @default(cuid())
  fullName            String  @map("full_name")
  logoText            String  @map("logo_text")
  title               String
  tagline             String?
  heroIntro           String? @db.Text @map("hero_intro")
  aboutBio            String  @db.Text @map("about_bio")
  aboutSummary        String? @db.Text @map("about_summary")
  technicalInterests  String? @db.Text @map("technical_interests")
  developmentApproach String? @db.Text @map("development_approach")
  currentGoals        String? @db.Text @map("current_goals")
  availabilityStatus  String? @map("availability_status")
  locationText        String? @map("location_text")
  contactEmail        String  @map("contact_email")

  defaultSeoTitle       String? @map("default_seo_title")
  defaultSeoDescription String? @map("default_seo_description")
  footerText            String? @map("footer_text")
  cvVersionLabel        String? @map("cv_version_label")
  cvUpdatedAt           DateTime? @map("cv_updated_at")
  maintenanceMode       Boolean @default(false) @map("maintenance_mode")

  // media refs
  profileImageId String? @map("profile_image_id")
  profileImage   MediaAsset? @relation("ProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)
  logoImageId    String? @map("logo_image_id")
  logoImage      MediaAsset? @relation("LogoImage", fields: [logoImageId], references: [id], onDelete: SetNull)
  faviconId      String? @map("favicon_id")
  favicon        MediaAsset? @relation("FaviconImage", fields: [faviconId], references: [id], onDelete: SetNull)
  cvFileId       String? @map("cv_file_id")
  cvFile         MediaAsset? @relation("CvFile", fields: [cvFileId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_profiles")
}

// ============================================================================
//  SOCIAL LINK  (reorderable list; header/footer placement)
// ============================================================================

model SocialLink {
  id           String   @id @default(cuid())
  platform     String // GitHub / LinkedIn / Google / Twitter / Email / Website / Other
  label        String?
  url          String
  iconKey      String? @map("icon_key") // lucide key
  iconMediaId  String? @map("icon_media_id")
  iconMedia    MediaAsset? @relation(fields: [iconMediaId], references: [id], onDelete: SetNull)
  showInHeader Boolean  @default(true) @map("show_in_header")
  showInFooter Boolean  @default(true) @map("show_in_footer")
  visible      Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("social_links")
}

// ============================================================================
//  PROJECT
// ============================================================================

model Project {
  id              String          @id @default(cuid())
  slug            String          @unique
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  versions        ProjectVersion[]
  technologies    ProjectTechnology[]
  images          ProjectImage[]
  timelineEntries TimelineEntry[]
  redirects       ProjectRedirect[]

  @@index([deletedAt])
  @@map("projects")
}

model ProjectVersion {
  id                    String          @id @default(cuid())
  projectId             String          @map("project_id")
  state                 PublishState
  title                 String
  summary               String
  fullDescription       String?         @db.Text @map("full_description")
  category              ProjectCategory @default(OTHER)
  startDate             DateTime?       @map("start_date")
  endDate               DateTime?       @map("end_date")
  status                ProjectStatus   @default(COMPLETED)

  // long-form detail fields
  problem            String? @db.Text
  solution           String? @db.Text
  myRole             String? @db.Text @map("my_role")
  mainFeatures       String? @db.Text @map("main_features")
  systemArchitecture String? @db.Text @map("system_architecture")
  developmentProcess String? @db.Text @map("development_process")
  challenges         String? @db.Text
  solutionsDetail    String? @db.Text @map("solutions_detail")
  testing            String? @db.Text
  results            String? @db.Text
  lessonsLearned     String? @db.Text @map("lessons_learned")
  metrics            Json?

  // links
  liveDemoUrl      String? @map("live_demo_url")
  githubUrl        String? @map("github_url")
  reportUrl        String? @map("report_url")
  documentationUrl String? @map("documentation_url")
  videoUrl         String? @map("video_url")
  presentationUrl  String? @map("presentation_url")

  // display flags
  featured       Boolean @default(false)
  showOnHomepage Boolean @default(false) @map("show_on_homepage")
  showOnTimeline Boolean @default(false) @map("show_on_timeline")
  showOnResume   Boolean @default(false) @map("show_on_resume")
  manualOrder    Int     @default(0) @map("manual_order")
  visible        Boolean @default(true)

  // SEO
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // media relations
  thumbnailId    String? @map("thumbnail_id")
  thumbnail      MediaAsset? @relation("ProjectThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  coverImageId   String? @map("cover_image_id")
  coverImage     MediaAsset? @relation("ProjectCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  architectureImageId String? @map("architecture_image_id")
  architectureImage   MediaAsset? @relation("ProjectArchitecture", fields: [architectureImageId], references: [id], onDelete: SetNull)

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, state])
  @@index([state, visible])
  @@index([manualOrder])
  @@map("project_versions")
}

model ProjectRedirect {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  oldSlug   String   @unique @map("old_slug")
  newSlug   String   @map("new_slug")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("project_redirects")
}

model ProjectImage {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String     @map("media_id")
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption   String?
  order     Int        @default(0)

  @@index([projectId, order])
  @@map("project_images")
}

model Technology {
  id              String          @id @default(cuid())
  slug            String          @unique
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  versions        TechnologyVersion[]
  projects        ProjectTechnology[]
  experienceTech  ExperienceTechnology[]
  timelineTech    TimelineTechnology[]

  @@index([deletedAt])
  @@map("technologies")
}

model TechnologyVersion {
  id              String          @id @default(cuid())
  technologyId    String          @map("technology_id")
  state           PublishState
  name            String
  category        TechCategory    @default(OTHER)
  description     String?
  experienceLabel ExperienceLabel @default(WORKING_KNOWLEDGE) @map("experience_label")
  showInStack     Boolean         @default(true) @map("show_in_stack")
  showInGame      Boolean         @default(false) @map("show_in_game")
  showOnResume    Boolean         @default(false) @map("show_on_resume")
  visible         Boolean         @default(true)
  order           Int             @default(0)
  publishedAt     DateTime?       @map("published_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  logoId          String?         @map("logo_id")
  logo            MediaAsset?     @relation(fields: [logoId], references: [id], onDelete: SetNull)

  technology      Technology      @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([technologyId, state])
  @@index([category])
  @@index([order])
  @@map("technology_versions")
}

model ProjectTechnology {
  projectId    String @map("project_id")
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technologyId String @map("technology_id")
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  order        Int        @default(0)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

model TimelineEntry {
  id              String            @id @default(cuid())
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  linkedProjectId String?           @map("project_id")
  linkedProject   Project?          @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)

  versions        TimelineEntryVersion[]
  technologies    TimelineTechnology[]

  @@index([deletedAt])
  @@map("timeline_entries")
}

model TimelineEntryVersion {
  id              String            @id @default(cuid())
  timelineEntryId String            @map("timeline_entry_id")
  state           PublishState
  title           String
  entryType       TimelineEntryType @default(PROJECT) @map("entry_type")
  startDate       DateTime          @map("start_date")
  endDate         DateTime?         @map("end_date")
  description     String?           @db.Text
  status          ProjectStatus?
  externalLinks   Json?             @map("external_links")
  visible         Boolean           @default(true)
  order           Int               @default(0)
  publishedAt     DateTime?         @map("published_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  imageId         String?           @map("image_id")
  image           MediaAsset?       @relation(fields: [imageId], references: [id], onDelete: SetNull)

  timelineEntry   TimelineEntry     @relation(fields: [timelineEntryId], references: [id], onDelete: Cascade)

  @@unique([timelineEntryId, state])
  @@index([startDate])
  @@index([order])
  @@map("timeline_entry_versions")
}

model TimelineTechnology {
  timelineEntryId String @map("timeline_entry_id")
  timelineEntry   TimelineEntry @relation(fields: [timelineEntryId], references: [id], onDelete: Cascade)
  technologyId    String @map("technology_id")
  technology      Technology    @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([timelineEntryId, technologyId])
  @@index([technologyId])
  @@map("timeline_technologies")
}

model Education {
  id            String    @id @default(cuid())
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  versions      EducationVersion[]

  @@index([deletedAt])
  @@map("education")
}

model EducationVersion {
  id            String    @id @default(cuid())
  educationId   String    @map("education_id")
  state         PublishState
  institution   String
  qualification String
  startDate     DateTime  @map("start_date")
  endDate       DateTime? @map("end_date")
  isCurrent     Boolean   @default(false) @map("is_current")
  grade         String?
  description   String?   @db.Text
  modules       String?
  showOnResume  Boolean   @default(true) @map("show_on_resume")
  visible       Boolean   @default(true)
  order         Int       @default(0)
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  logoId        String?     @map("logo_id")
  logo          MediaAsset? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  education     Education   @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@unique([educationId, state])
  @@index([order])
  @@map("education_versions")
}

model Experience {
  id               String    @id @default(cuid())
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  versions         ExperienceVersion[]
  technologies     ExperienceTechnology[]

  @@index([deletedAt])
  @@map("experience")
}

model ExperienceVersion {
  id               String    @id @default(cuid())
  experienceId     String    @map("experience_id")
  state            PublishState
  organization     String
  role             String
  startDate        DateTime  @map("start_date")
  endDate          DateTime? @map("end_date")
  isCurrent        Boolean   @default(false) @map("is_current")
  description      String?   @db.Text
  responsibilities Json?
  locationText     String?   @map("location_text")
  workType         WorkType? @map("work_type")
  showOnResume     Boolean   @default(true) @map("show_on_resume")
  visible          Boolean   @default(true)
  order            Int       @default(0)
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  logoId           String?     @map("logo_id")
  logo             MediaAsset? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  experience       Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, state])
  @@index([order])
  @@map("experience_versions")
}

model ExperienceTechnology {
  experienceId String @map("experience_id")
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  technologyId String @map("technology_id")
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([experienceId, technologyId])
  @@index([technologyId])
  @@map("experience_technologies")
}

// ============================================================================
//  TEMPLATE  (the three selectable public skins)
// ============================================================================

model Template {
  id           String      @id @default(cuid())
  key          TemplateKey @unique
  name         String
  description  String?
  previewImageUrl String? @map("preview_image_url")
  isActiveLive Boolean     @default(false) @map("is_active_live")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  pages Page[]

  @@map("templates")
}

// ============================================================================
//  PAGE  +  PAGE SECTION  +  PAGE VERSION  (the page-builder core)
// ============================================================================

model Page {
  id        String   @id @default(cuid())
  key       String   @unique // "home"
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  draftTemplateId String? @map("draft_template_id")
  draftTemplate   Template? @relation(fields: [draftTemplateId], references: [id], onDelete: SetNull)

  hasUnpublishedChanges Boolean @default(false) @map("has_unpublished_changes")

  sections PageSection[]
  versions PageVersion[]

  @@map("pages")
}

model PageSection {
  id           String      @id @default(cuid())
  pageId       String @map("page_id")
  page         Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type         SectionType
  internalLabel String @map("internal_label")
  order        Int         @default(0)
  visible      Boolean     @default(true)
  settings     Json        @default("{}")
  animationPresetSlug String? @map("animation_preset_slug")
  animationDelay      Float?  @default(0) @map("animation_delay")
  animationStagger    Float?  @default(0.08) @map("animation_stagger")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pageId, order])
  @@map("page_sections")
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String @map("page_id")
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  versionNumber Int @map("version_number")
  templateKey TemplateKey @map("template_key")
  snapshot    Json
  changeSummary Json? @map("change_summary")
  isActive    Boolean  @default(false) @map("is_active")
  rollbackUntil DateTime? @map("rollback_until")
  publishedById String? @map("published_by_id")
  publishedBy   User?    @relation("VersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([pageId, versionNumber])
  @@index([pageId, isActive])
  @@map("page_versions")
}

// ============================================================================
//  GAME SETTINGS  (single row config for the 3D section)
// ============================================================================

model GameSettings {
  id             String   @id @default(cuid())
  enabled        Boolean  @default(false)
  mode           GameMode @default(ROTATING_SPHERE)
  selectedTechIds Json? @map("selected_tech_ids")
  ballCount      Int      @default(12) @map("ball_count")
  ballSize       Float    @default(1) @map("ball_size")
  fallingSpeed   Float    @default(1) @map("falling_speed")
  difficulty     Int      @default(1)
  soundEnabled   Boolean  @default(false) @map("sound_enabled")
  showScore      Boolean  @default(true) @map("show_score")
  instructions   String?
  backgroundStyle String? @map("background_style")
  physicsEnabled Boolean  @default(false) @map("physics_enabled")
  saveScores     Boolean  @default(false) @map("save_scores")
  leaderboard    Boolean  @default(false)
  mobileFallback Boolean  @default(true) @map("mobile_fallback")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("game_settings")
}

model GameScore {
  id         String   @id @default(cuid())
  playerName String @map("player_name")
  score      Int
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([score])
  @@map("game_scores")
}

// ============================================================================
//  CONTACT MESSAGE  (guest-created; admin reads/updates status)
// ============================================================================

model ContactMessage {
  id        String          @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String          @db.Text
  category  MessageCategory @default(GENERAL)
  status    MessageStatus   @default(NEW)
  ipHash    String? @map("ip_hash")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ============================================================================
//  AUDIT LOG  (read-only trail of all important admin actions)
//
//  action is a free-form string to allow fine-grained event labelling:
//  LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, PASSWORD_CHANGED,
//  GOOGLE_LINKED, GOOGLE_UNLINKED, SESSION_REVOKED,
//  PROJECT_CREATED, PROJECT_UPDATED, PROJECT_DELETED, PROJECT_RESTORED,
//  SECTION_ADDED, SECTION_UPDATED, SECTION_DELETED, SECTION_REORDERED,
//  TEMPLATE_CHANGED, PAGE_PUBLISHED, PAGE_ROLLED_BACK,
//  MEDIA_UPLOADED, MEDIA_DELETED, SETTINGS_UPDATED
// ============================================================================

model AuditLog {
  id              String   @id @default(cuid())
  /// Free-form action label — see comment above for valid values
  action          String
  entityType      String   @map("entity_type") // "User" | "Project" | "PageVersion" | ...
  entityId        String?  @map("entity_id")
  summary         String?  // one-line human description
  /// loginMethod that created this action's session: "LOCAL" | "GOOGLE" | null
  loginMethod     String?  @map("login_method")
  /// Account.id when loginMethod = GOOGLE; null for LOCAL or system events
  loginAccountId  String?  @map("login_account_id")
  /// Redacted before-snapshot of the changed record
  beforeJson      Json?    @map("before_json")
  /// Redacted after-snapshot of the changed record
  afterJson       Json?    @map("after_json")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  actorId String? @map("actor_id")
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

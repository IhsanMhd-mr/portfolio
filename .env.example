# Copy to .env and fill in. NEVER put real values in this file — it is the one
# .env* path that is deliberately committed (see .gitignore).

# ── Database ────────────────────────────────────────────────────────────────
# Primary database. Every script targets this unless told otherwise.
# For a hosted Postgres, prefer the POOLED connection string.
DATABASE_URL="postgresql://user:password@host:5432/portfolio?sslmode=require"

# Local Postgres, used by `npm run dev` (which sets DB_TARGET=local).
# Omit this if you only ever run against DATABASE_URL.
DATABASE_URL_LOCAL="postgresql://postgres:password@localhost:5432/portfolio?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# Session signing key. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXTAUTH_SECRET is accepted as a fallback.
AUTH_SECRET=""

# Google sign-in. Optional — omit both to disable that provider.
# The authorised redirect URI must be <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── OTP recovery (NOT IMPLEMENTED) ─────────────────────────────────────────
# Provider-specific names are intentionally deferred until providers are
# selected. Future configuration will need an email API credential + verified
# sender and/or SMS account credential + sender identity. Adding values here
# alone does not enable password recovery.

# ── First-run accounts ──────────────────────────────────────────────────────
# Password for the permanent superadmin created by `npm run admin:super`.
# Set this before the first run; the account is not re-created afterwards.
SUPERADMIN_PASSWORD=""

# Optional: fixes the `admin` password that `npm run initialize` would otherwise
# generate and print once. Leave unset to get a generated one.
INITIAL_PASSWORD=""

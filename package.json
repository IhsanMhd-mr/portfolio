{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "clean": "powershell -Command \"@(3000) | ForEach-Object { $port=$_; $procId=(Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue).OwningProcess; if($procId){Stop-Process -Id $procId -Force -ErrorAction SilentlyContinue; Write-Host \\\"Killed port $port (PID $procId)\\\"} else {Write-Host \\\"Port $port is free\\\"} }\"",
    "dev": "cross-env DB_TARGET=local node --env-file=.env scripts/dev-start.js",
    "dev:cloud": "node --env-file=.env scripts/dev-start.js",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "initialize": "node --env-file=.env scripts/initialize.js",
    "admin:init": "npm run initialize",
    "admin:super": "node --env-file=.env scripts/initialise_admin.js",
    "content:clear": "node --env-file=.env scripts/clear-descriptions.js",
    "content:push-cloud": "node --env-file=.env scripts/push-content-to-cloud.js",
    "seed": "node --env-file=.env scripts/seed-content.js",
    "db:setup": "node scripts/database-setup.js deploy",
    "db:migrate": "node scripts/database-setup.js migrate",
    "db:push": "node scripts/database-setup.js push",
    "db:reset": "node scripts/database-setup.js reset --yes",
    "db:verify": "node --env-file=.env scripts/verify-initialization.js",
    "check:promoted": "node scripts/check-promoted-fields.js",
    "deploy:setup": "node scripts/database-setup.js deploy",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:http": "cross-env TEST_HTTP=1 vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "tsx src/prisma/seed.ts"
  }
}
